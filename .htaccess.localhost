# Use on LOCALHOST only (XAMPP: http://localhost/riskwisdom)
# Do NOT deploy this file to production — production uses .htaccess.production

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /riskwisdom/
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /riskwisdom/index.php [L]
</IfModule>
# END WordPress
